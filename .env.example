# ───────────── Database ─────────────
# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ideal-science-college?retryWrites=true&w=majority

# ───────────── Authentication ─────────────
# Public URL of the site (http://localhost:3000 locally)
NEXTAUTH_URL=http://localhost:3000
# 32+ random characters — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ───────────── Cloudinary (document & image uploads) ─────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ───────────── Email (Brevo transactional API) ─────────────
BREVO_API_KEY=
# Must be a sender verified in Brevo
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME="Ideal Science College"
# Optional: where new application / contact alerts go (defaults to the contact email in Site Settings)
ADMIN_NOTIFY_EMAIL=

# ───────────── AI assistant (Anthropic Claude) ─────────────
ANTHROPIC_API_KEY=

# ───────────── Site ─────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Ideal Science College"

# ───────────── Analytics (optional) ─────────────
NEXT_PUBLIC_GA_ID=

# ───────────── Seed script (npm run seed) ─────────────
SEED_OWNER_EMAIL=admin@idealsciencecollege.com
# Leave empty to auto-generate a strong password (printed once)
SEED_OWNER_PASSWORD=
